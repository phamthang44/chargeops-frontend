# Native Expo/production builds use the same public gateway as the Web Portal.
# Port 8082 remains only the local Expo Web/Metro development server.
EXPO_PUBLIC_KEYCLOAK_ISSUER_URL=https://thang.tail704409.ts.net/realms/chargeops
EXPO_PUBLIC_KEYCLOAK_DRIVER_CLIENT_ID=chargeops-driver-mobile
EXPO_PUBLIC_KEYCLOAK_REDIRECT_SCHEME=chargeops
# Optional when Account Console is exposed through a separate gateway URL.
# Defaults to <EXPO_PUBLIC_KEYCLOAK_ISSUER_URL>/account.
EXPO_PUBLIC_KEYCLOAK_ACCOUNT_URL=https://thang.tail704409.ts.net/realms/chargeops/account
# Owner console opened from Profile & Settings. Expo Web uses this exact origin;
# native builds open it in the device's system browser.
EXPO_PUBLIC_OWNER_PORTAL_URL=https://thang.tail704409.ts.net
# Services append /api/v1 themselves; no internal backend port is exposed here.
EXPO_PUBLIC_API_BASE_URL=https://thang.tail704409.ts.net
# Set to 'true' to run fully on mock data (stations, availability, bookings, auth)
# without requiring backend or Keycloak connectivity.
EXPO_PUBLIC_USE_MOCKS=true

