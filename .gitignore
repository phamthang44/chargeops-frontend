# ChargeOps monorepo — root ignore rules (apply to all apps)

# Dependencies
node_modules/

# Expo / React Native (driver-mobile)
.expo/
dist/
web-build/
expo-env.d.ts
*.orig.*
*.jks
*.p8
*.p12
*.key
