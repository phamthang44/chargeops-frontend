# Local browser demo runs Expo Web at http://localhost:8082.
# In Keycloak, allow redirect URI http://localhost:8082/* and web origin http://localhost:8082.
EXPO_PUBLIC_KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/chargeops
EXPO_PUBLIC_KEYCLOAK_DRIVER_CLIENT_ID=chargeops-driver-mobile
EXPO_PUBLIC_KEYCLOAK_REDIRECT_SCHEME=chargeops
# Optional when Account Console is exposed through a separate gateway URL.
# Defaults to <EXPO_PUBLIC_KEYCLOAK_ISSUER_URL>/account.
EXPO_PUBLIC_KEYCLOAK_ACCOUNT_URL=http://localhost:8080/realms/chargeops/account
# Owner console opened from Profile & Settings. Expo Web uses this exact origin;
# native builds open it in the device's system browser.
EXPO_PUBLIC_OWNER_PORTAL_URL=http://localhost:5173
# Web uses localhost. Change this to http://10.0.2.2:8081 for an Android
# emulator, or to the backend's LAN URL for a physical device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
