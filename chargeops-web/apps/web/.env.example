# Copy to .env to override defaults.

# Backend REST API base URL (Spring Boot).
#VITE_API_URL=http://localhost:8081/api/v1

# "false" -> call the real API; anything else (or unset) -> in-memory mock data.
#VITE_USE_MOCKS=false

# Hosted Keycloak login. Leave false to keep the local demo identity picker.
#VITE_KEYCLOAK_ENABLED=true
#VITE_KEYCLOAK_URL=http://localhost:8080
#VITE_KEYCLOAK_REALM=chargeops
#VITE_KEYCLOAK_CLIENT_ID=chargeops-web

# Driver Mobile Web URL (Expo Web chạy ở cổng 8082)
#VITE_DRIVER_APP_URL_DEV=http://localhost:8082
#VITE_DRIVER_APP_URL=http://localhost:8082

