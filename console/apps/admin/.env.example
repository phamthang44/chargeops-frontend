# Copy to .env to override defaults.

# Backend REST API base URL (Spring Boot). Default: /api/v1 (same-origin proxy).
#VITE_API_URL=http://localhost:8080/api/v1

# "false" → call the real API; anything else (or unset) → in-memory mock data.
#VITE_USE_MOCKS=false

# Portal launcher URL (logo click).
#VITE_PORTAL_URL=http://localhost:5170
