# Next.js (owner-web / admin-web — later)
.next/
out/

# Java / Spring Boot (backend/ — later)
target/
build/
.gradle/
*.class

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local agent tooling (not part of the project)
.claude/
.agents/
skills-lock.json
